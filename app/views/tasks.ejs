<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My Tasks | UniSpace</title><link rel="stylesheet" href="/css/styles.css"></head><body>
<div class="app-layout"><%- include("partials/sidebar") %><main class="main-content"><%- include("partials/header") %>
<section class="welcome-section"><p class="eyebrow">GET THINGS DONE</p><h1>My Tasks</h1><p>Keep track of what matters and make progress every day.</p></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">NEW TASK</p><h2>Add a task</h2></div></div>
<form action="/tasks/add" method="POST" class="form-card form-grid">
<div class="form-group"><label for="task">Task name</label><input type="text" id="task" name="task" placeholder="What needs to be done?" maxlength="180" required></div>
<div class="form-group"><label for="description">Description <span class="optional">Optional</span></label><textarea id="description" name="description" placeholder="Add some details..." rows="3" maxlength="2000"></textarea></div>
<div class="form-row"><div class="form-group"><label for="priority">Priority</label><select id="priority" name="priority"><option>Low</option><option selected>Medium</option><option>High</option></select></div><div class="form-group"><label for="dueDate">Due date <span class="optional">Optional</span></label><input type="date" id="dueDate" name="dueDate"></div></div>
<button type="submit" class="primary-btn">Add task <span aria-hidden="true">＋</span></button></form></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">YOUR WORKLOAD</p><h2>All tasks</h2></div><span class="task-count"><%= tasks.length %> <%= tasks.length === 1 ? 'task' : 'tasks' %></span></div>
<% if (!tasks.length) { %><div class="empty-state"><span class="empty-icon">✦</span><strong>A clear desk, ready for ideas</strong><p>When you add a task, it’ll show up here.</p></div><% } else { %>
<div class="task-list"><% tasks.forEach(task => { %><article class="task-card <%= task.completed ? 'is-complete' : '' %>" id="task-<%= task._id %>">
<div class="task-card-top"><div><span class="status <%= task.completed ? 'done' : 'pending' %>"><%= task.completed ? 'Completed' : 'In progress' %></span><span class="priority <%= (task.priority || 'Medium').toLowerCase() %>"><%= task.priority || 'Medium' %></span></div>
<form action="/tasks/<%= task._id %>/bookmark" method="POST"><button type="submit" class="icon-btn" aria-label="<%= task.bookmarked ? 'Remove task bookmark' : 'Bookmark task' %>" title="<%= task.bookmarked ? 'Remove bookmark' : 'Bookmark' %>"><%= task.bookmarked ? '★' : '☆' %></button></form></div>
<form action="/tasks/<%= task._id %>/edit" method="POST" class="task-edit-form"><label class="sr-only" for="task-name-<%= task._id %>">Task name</label><input id="task-name-<%= task._id %>" name="task" value="<%= task.task %>" maxlength="180" required class="item-title-input <%= task.completed ? 'completed' : '' %>"><label class="sr-only" for="task-desc-<%= task._id %>">Description</label><textarea id="task-desc-<%= task._id %>" name="description" rows="2" maxlength="2000" placeholder="Add a description"><%= task.description || '' %></textarea>
<div class="form-row compact-row"><div class="form-group"><label for="task-priority-<%= task._id %>">Priority</label><select id="task-priority-<%= task._id %>" name="priority"><% ['Low','Medium','High'].forEach(level => { %><option <%= task.priority === level ? 'selected' : '' %>><%= level %></option><% }) %></select></div><div class="form-group"><label for="task-date-<%= task._id %>">Due date</label><input id="task-date-<%= task._id %>" type="date" name="dueDate" value="<%= task.dueDate ? new Date(task.dueDate).toISOString().slice(0,10) : '' %>"></div></div><button type="submit" class="text-link save-link">Save changes</button></form>
<div class="task-actions"><form action="/tasks/<%= task._id %>/complete" method="POST"><button type="submit" class="secondary-btn"><%= task.completed ? '↶ Mark pending' : '✓ Mark complete' %></button></form><form action="/tasks/<%= task._id %>/delete" method="POST" onsubmit="return confirm('Delete this task?')"><button type="submit" class="subtle-danger">Delete</button></form></div></article><% }) %></div><% } %></section>
</main></div></body></html>
