<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Bookmarks | UniSpace</title><link rel="stylesheet" href="/css/styles.css"></head><body>
<div class="app-layout"><%- include("partials/sidebar") %><main class="main-content"><%- include("partials/header") %>
<section class="welcome-section"><p class="eyebrow">QUICK ACCESS</p><h1>Your bookmarks</h1><p>Everything important, saved in one place.</p><div class="bookmark-summary"><span><strong><%= tasks.length + pages.length + resources.length %></strong> saved items</span><span><%= tasks.length %> tasks · <%= pages.length %> pages · <%= resources.length %> resources</span></div></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">YOUR WORK</p><h2>Saved tasks <span class="heading-count"><%= tasks.length %></span></h2></div></div>
<% if (!tasks.length) { %><div class="empty-state compact-empty">No bookmarked tasks yet. Save a task with the star icon.</div><% } else { %><div class="bookmark-list"><% tasks.forEach(task => { %><article class="bookmark-item"><a class="bookmark-main" href="/tasks#task-<%= task._id %>"><span class="type-icon task-type">✓</span><span><small>Task · <%= task.priority %> priority</small><strong class="<%= task.completed ? 'completed' : '' %>"><%= task.task %></strong></span></a><form action="/tasks/<%= task._id %>/bookmark" method="POST"><input type="hidden" name="returnTo" value="bookmarks"><button class="icon-btn" type="submit" aria-label="Remove task bookmark">★</button></form></article><% }) %></div><% } %></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">YOUR NOTES</p><h2>Saved pages <span class="heading-count"><%= pages.length %></span></h2></div></div>
<% if (!pages.length) { %><div class="empty-state compact-empty">No bookmarked pages yet. Save a page with the star icon.</div><% } else { %><div class="bookmark-list"><% pages.forEach(page => { %><article class="bookmark-item"><a class="bookmark-main" href="/pages#page-<%= page._id %>"><span class="type-icon page-type">▤</span><span><small>Page · Updated <%= page.updatedAt ? new Date(page.updatedAt).toLocaleDateString() : 'recently' %></small><strong><%= page.title %></strong><span class="bookmark-description"><%= (page.content || '').slice(0, 100) %></span></span></a><form action="/pages/<%= page._id %>/bookmark" method="POST"><input type="hidden" name="returnTo" value="bookmarks"><button class="icon-btn" type="submit" aria-label="Remove page bookmark">★</button></form></article><% }) %></div><% } %></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">YOUR COLLECTION</p><h2>Saved resources <span class="heading-count"><%= resources.length %></span></h2></div></div>
<% if (!resources.length) { %><div class="empty-state compact-empty">No bookmarked resources yet. Save one with the star icon.</div><% } else { %><div class="bookmark-list"><% resources.forEach(resource => { %><article class="bookmark-item"><a class="bookmark-main" href="/library#resource-<%= resource._id %>"><span class="type-icon resource-type">↗</span><span><small>Resource · <%= resource.category %></small><strong><%= resource.title %></strong><span class="bookmark-description"><%= resource.description || resource.url %></span></span></a><form action="/library/<%= resource._id %>/bookmark" method="POST"><input type="hidden" name="returnTo" value="bookmarks"><button class="icon-btn" type="submit" aria-label="Remove resource bookmark">★</button></form></article><% }) %></div><% } %></section>
</main></div></body></html>
