<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Knowledge Library | UniSpace</title><link rel="stylesheet" href="/css/styles.css"></head><body>
<div class="app-layout"><%- include("partials/sidebar") %><main class="main-content"><%- include("partials/header") %>
<section class="welcome-section"><p class="eyebrow">YOUR KNOWLEDGE HUB</p><h1>Knowledge Library</h1><p>Collect useful links, articles, tools and learning resources.</p></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">BUILD YOUR COLLECTION</p><h2>Save a resource</h2></div></div><form action="/library/add" method="POST" class="form-card form-grid">
<div class="form-group"><label for="title">Resource title</label><input id="title" name="title" maxlength="180" placeholder="Enter resource name..." required></div><div class="form-group"><label for="url">URL</label><input id="url" name="url" type="url" placeholder="https://example.com" required></div><div class="form-group"><label for="description">Description <span class="optional">Optional</span></label><textarea id="description" name="description" rows="3" maxlength="2000" placeholder="What is this resource about?"></textarea></div><div class="form-group"><label for="category">Category</label><select id="category" name="category"><option>General</option><option>Learning</option><option>Development</option><option>Research</option><option>Tools</option><option>Articles</option></select></div><button type="submit" class="primary-btn">Save resource <span aria-hidden="true">＋</span></button></form></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">YOUR COLLECTION</p><h2>All resources</h2></div><span class="task-count"><%= resources.length %> <%= resources.length === 1 ? 'resource' : 'resources' %></span></div>
<% if (!resources.length) { %><div class="empty-state"><span class="empty-icon">↗</span><strong>Keep the good things close</strong><p>Save a link you want to come back to later.</p></div><% } else { %><div class="resource-grid"><% resources.forEach(resource => { %><article class="resource-card" id="resource-<%= resource._id %>"><div class="card-kicker"><span class="category-pill"><%= resource.category || 'General' %></span><form action="/library/<%= resource._id %>/bookmark" method="POST"><button class="icon-btn" type="submit" aria-label="<%= resource.bookmarked ? 'Remove bookmark' : 'Bookmark resource' %>" title="<%= resource.bookmarked ? 'Remove bookmark' : 'Bookmark' %>"><%= resource.bookmarked ? '★' : '☆' %></button></form></div>
<form action="/library/<%= resource._id %>/edit" method="POST" class="resource-edit-form"><div class="form-group"><label for="resource-title-<%= resource._id %>">Title</label><input id="resource-title-<%= resource._id %>" name="title" value="<%= resource.title %>" required maxlength="180"></div><div class="form-group"><label for="resource-url-<%= resource._id %>">URL</label><input id="resource-url-<%= resource._id %>" name="url" type="url" value="<%= resource.url %>" required></div><div class="form-group"><label for="resource-desc-<%= resource._id %>">Description</label><textarea id="resource-desc-<%= resource._id %>" name="description" rows="2" maxlength="2000"><%= resource.description || '' %></textarea></div><div class="form-group"><label for="resource-category-<%= resource._id %>">Category</label><input id="resource-category-<%= resource._id %>" name="category" value="<%= resource.category || 'General' %>" maxlength="60"></div><div class="resource-footer"><a href="<%= resource.url %>" target="_blank" rel="noopener noreferrer" class="text-link">Open resource ↗</a><button type="submit" class="text-link">Save changes</button></div></form><form class="delete-row" action="/library/<%= resource._id %>/delete" method="POST" onsubmit="return confirm('Delete this resource?')"><button type="submit" class="subtle-danger">Delete resource</button></form></article><% }) %></div><% } %></section>
</main></div></body></html>
